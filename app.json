{
  "expo": {
    "name": "K1 Segurança",
    "slug": "k1-seguranca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.k1.seguranca"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.k1.seguranca",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O K1 Segurança usa a câmera para ler o QR code da ronda, tirar foto das ocorrências e, no K1 Família, gravar o SOS.",
          "recordAudioAndroid": true,
          "microphonePermission": "No K1 Família, o SOS grava o áudio para a central ouvir o que está acontecendo."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O K1 Segurança usa a câmera para tirar foto das ocorrências.",
          "photosPermission": false
        }
      ]
    ],
    "scheme": "k1seguranca",
    "backgroundColor": "#000000",
    "owner": "k1cyberbr",
    "extra": {
      "eas": {
        "projectId": "a77f9353-5ac7-4438-8d5a-bbcc0146314b"
      }
    }
  }
}